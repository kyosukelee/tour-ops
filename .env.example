# このファイルをコピーして .env.local を作り、値を入れてください(.env.local は Git に入れない)

# Neon の接続文字列(Neon の管理画面 → Connect で表示される postgresql://... )
DATABASE_URL=

# ログイン用の秘密鍵(32文字以上のランダムな文字列)
# 作り方: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# アプリのURL(手元では http://localhost:3000、公開時は公開URL)
BETTER_AUTH_URL=http://localhost:3000

# デモ用アカウントの共通パスワード(npm run db:seed で使う。10文字以上)
SEED_DEMO_PASSWORD=tour-ops-demo

# true にすると、ログイン画面にデモ用アカウントを表示する(公開デモ用)
DEMO_MODE=true

# ---------- メール送信(手配依頼書の送付。ステップ4) ----------
# Resend の API キー。空欄なら実際には送らず、サーバーのログに出すだけ(開発用)
RESEND_API_KEY=
# 差出人。独自ドメインを登録するまでは Resend の onboarding@resend.dev を使う
MAIL_FROM=tour-ops <onboarding@resend.dev>
# デモ用: 宛先をすべてこのアドレスに差し替える(実在の仕入先へは送らない)
# onboarding@resend.dev から送れるのは Resend に登録した自分のアドレスだけなので、そのアドレスを入れる
DEMO_MAIL_TO=

# 自社情報(依頼書PDFとメールの署名に載る。空欄ならデモ用の架空の会社)
# COMPANY_NAME=
# COMPANY_DEPARTMENT=
# COMPANY_TEL=
# COMPANY_FAX=
# COMPANY_EMAIL=

# ---------- 毎朝の処理(ステップ5) ----------
# Vercel Cron が /api/cron/daily を呼ぶときの合言葉(16文字以上のランダムな文字列)
# 作り方: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
# true にすると、毎朝の処理でデモデータを今日の日付で作り直す(公開デモ用。手元では false のままでよい)
DEMO_RESET=false

# ---------- 添付書類の保管場所(ステップ6) ----------
# Cloudflare R2 のバケット。4つとも空欄なら、手元の .data/uploads フォルダに保存する(Vercel 上では R2 が必須)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------- エラー監視(Sentry。ステップ7) ----------
# 空欄なら Sentry には何も送らない
SENTRY_DSN=
# ブラウザ側。ビルド時に埋め込まれるので、Vercel では環境変数に入れてから再デプロイする
NEXT_PUBLIC_SENTRY_DSN=
# 任意: ビルドのソースマップを Sentry に送る(エラーの場所を元のソースで見られる)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ---------- 画面テスト(Playwright。ステップ7) ----------
# 中身を毎回消して作り直す、テスト専用のデータベース(手元の Postgres。本番の Neon は指定しない)
# E2E_DATABASE_URL=postgresql://tour_ops:tour_ops@localhost:5433/tour_ops_e2e
